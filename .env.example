# Copy to .env (never committed) and set the password. Docker Compose reads this file; export the same
# variables in the shell that starts InfoScry, which reads them from its environment.
INFOSCRY_DATABASE_PASSWORD=change-me
INFOSCRY_DATABASE_USER=infoscry
INFOSCRY_DATABASE_NAME=infoscry
INFOSCRY_DATABASE_PORT=5432
INFOSCRY_DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/infoscry
# The data directory: library/, logs/, models/, tmp/ and uploads/ live in it. Defaults to ~/.infoscry;
# --data-dir overrides it.
# INFOSCRY_DATA_DIR=/Users/you/.infoscry
# Only to keep imported documents somewhere else, such as a larger disk: the library itself, one directory per
# collection. Defaults to <data directory>/library; never the data directory itself. The folder holding it must
# exist (a disk that is not connected stops the server from starting).
# INFOSCRY_LIBRARY_DIR=/Volumes/Archive/InfoScry
